{"tag":"<!doctype html>\n<html lang=\"en-NG\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>{$page.title}</title>\n<meta name=\"description\" content=\"{$page.description}\">\n{if $page.keywords}<meta name=\"keywords\" content=\"{$page.keywords}\">{/if}\n{if $page.canonical}<link rel=\"canonical\" href=\"{$page.canonical}\">{/if}\n{if $page.noindex}<meta name=\"robots\" content=\"noindex,nofollow\">{else}<meta name=\"robots\" content=\"index,follow,max-image-preview:large,max-snippet:-1\">{/if}\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:locale\" content=\"en_NG\">\n<meta property=\"og:site_name\" content=\"{$site.name}\">\n<meta property=\"og:title\" content=\"{$page.title}\">\n<meta property=\"og:description\" content=\"{$page.description}\">\n{if $page.canonical}<meta property=\"og:url\" content=\"{$page.canonical}\">{/if}\n{if $page.og_image}<meta property=\"og:image\" content=\"{$page.og_image}\">\n<meta property=\"og:image:width\" content=\"512\">\n<meta property=\"og:image:height\" content=\"512\">{/if}\n{if $page.canonical}<meta name=\"twitter:url\" content=\"{$page.canonical}\">{/if}\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:title\" content=\"{$page.title}\">\n<meta name=\"twitter:description\" content=\"{$page.description}\">\n{if $page.og_image}<meta name=\"twitter:image\" content=\"{$page.og_image}\">{/if}\n<style>\n:root{--green:#01875f;--green-h:#056449;--star:#FBBC04;--fg:#202124;--muted:#5f6368;--border:#dadce0;--chip-bg:#f1f3f4;--link:#0b57d0;--blue:#1a73e8;--track:#e8eaed}\n*{box-sizing:border-box;margin:0;padding:0}\nbody{font-family:Roboto,Arial,sans-serif;font-size:14px;line-height:1.5;color:var(--fg);background:#fff;-webkit-font-smoothing:antialiased}\na{color:var(--link);text-decoration:none}\na:hover{color:#174ea6}\n.topbar{position:sticky;top:0;z-index:10;background:#fff;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:4px;height:64px;padding:0 20px}\n.logo{display:flex;align-items:center;gap:10px;color:var(--muted);font-family:'Google Sans',Roboto,Arial,sans-serif;font-size:22px;font-weight:500;line-height:1;white-space:nowrap}\n.logo svg{flex:0 0 auto}\n.search{flex:1;display:flex;align-items:center;gap:12px;background:var(--chip-bg);border:1px solid transparent;border-radius:24px;height:46px;padding:0 18px;margin-left:16px;max-width:720px}\n.search:focus-within{background:#fff;border-color:var(--border)}\n.search svg{fill:var(--muted);flex:0 0 auto}\n.search input{flex:1;border:none;background:transparent;outline:none;font-size:15px;color:var(--fg)}\n.topbar .help{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:18px}\n.topbar .help:hover{background:var(--chip-bg)}\n.avatar{width:32px;height:32px;border-radius:50%;background:var(--chip-bg);display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:15px}\nmain{max-width:1280px;margin:0 auto;padding:8px 28px 40px}\n.app-head{display:grid;grid-template-columns:120px 1fr auto;gap:24px;align-items:start;padding:16px 0}\n.icon{width:120px;height:120px;border-radius:24px;background:linear-gradient(135deg,{$app.icon_bg},{$app.icon_bg2});display:flex;align-items:center;justify-content:center;font-family:'Google Sans',Roboto,Arial,sans-serif;font-size:52px;font-weight:500;color:#fff;box-shadow:0 1px 4px rgba(0,0,0,.2)}\n.app-meta h1{font-family:'Google Sans',Roboto,Arial,sans-serif;font-size:32px;font-weight:500;line-height:1.25}\n.dev{color:var(--green);font-size:14px;font-weight:500;margin:2px 0 8px}\n.rating-line{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:13px}\n.score{font-weight:500;font-size:14px}\n.stars{position:relative;display:inline-block;font-size:16px;line-height:1;color:#dadce0;letter-spacing:1px}\n.stars .fill{position:absolute;left:0;top:0;overflow:hidden;color:var(--star);white-space:nowrap}\n.muted{color:var(--muted)}\n.dot{color:var(--border);padding:0 2px}\n.rated{display:inline-flex;align-items:center;gap:6px;color:var(--muted);font-size:12px;margin-left:4px}\n.rated .box{width:18px;height:18px;border:1px solid #9aa0a6;border-radius:4px;display:inline-flex;align-items:center;justify-content:center;font-size:10px;font-weight:500;color:#5f6368;line-height:1}\n.badges{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}\n.badge{border:1px solid var(--border);border-radius:8px;padding:3px 10px;font-size:12px;color:var(--muted)}\n.actions{display:flex;flex-direction:column;align-items:flex-end;gap:10px}\n.install{background:var(--green);color:#fff;border-radius:8px;height:36px;line-height:36px;padding:0 24px;font-family:'Google Sans',Roboto,Arial,sans-serif;font-size:14px;font-weight:500;letter-spacing:.25px;display:inline-block;text-align:center;min-width:120px}\n.install:hover{background:var(--green-h);color:#fff}\n.play-protect{display:flex;align-items:center;gap:6px;color:var(--muted);font-size:12px}\n.play-protect svg{fill:var(--green)}\n.shots{display:flex;gap:16px;padding:8px 0 20px;overflow:hidden}\n.shot{width:144px;height:256px;border-radius:16px;border:1px solid var(--border);background:linear-gradient(160deg,{$app.icon_bg}22,{$app.icon_bg2}33);display:flex;align-items:center;justify-content:center;font-family:'Google Sans',Roboto,Arial,sans-serif;font-size:28px;font-weight:500;color:rgba(32,33,36,.55);flex:0 0 auto}\n.tabs{display:flex;gap:28px;border-bottom:1px solid var(--border);margin-bottom:4px;overflow-x:auto}\n.tab{padding:12px 2px;font-family:'Google Sans',Roboto,Arial,sans-serif;font-size:14px;font-weight:500;color:var(--muted);border-bottom:2px solid transparent;margin-bottom:-1px;white-space:nowrap}\n.tab.active{color:var(--green);border-bottom-color:var(--green)}\n.two-col{display:flex;gap:40px;padding-top:16px}\n.col-main{flex:1;min-width:0}\n.col-side{width:276px;flex:0 0 auto}\nh2{font-family:'Google Sans',Roboto,Arial,sans-serif;font-size:20px;font-weight:500;margin:0 0 12px}\n.about p{margin:0 0 12px;color:#333;font-size:14px}\n.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 32px;margin-top:20px}\n.info b{display:block;font-weight:400;font-size:12px;color:var(--muted);margin-bottom:2px}\n.info span{font-size:13px;color:var(--fg)}\n.card{border:1px solid var(--border);border-radius:12px;padding:20px;margin-bottom:20px}\n.card h3{font-family:'Google Sans',Roboto,Arial,sans-serif;font-size:16px;font-weight:500;margin:0 0 10px}\n.shield{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:13px;margin-bottom:10px}\n.shield svg{fill:var(--muted);flex:0 0 auto}\n.ds-row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 0;border-top:1px solid var(--border);font-size:13px}\n.ds-row:first-of-type{border-top:none}\n.ds-row .k{color:var(--fg)}\n.ds-row .v{color:var(--muted);font-size:12px;text-align:right;max-width:150px}\n.rev-head{display:flex;align-items:center;gap:12px;margin-bottom:14px}\n.rev-head .big{font-family:'Google Sans',Roboto,Arial,sans-serif;font-size:44px;font-weight:500;line-height:1}\n.rev-head .meta{font-size:13px;color:var(--muted)}\n.hist{margin:12px 0}\n.hist .row{display:flex;align-items:center;gap:12px;margin:4px 0;font-size:12px;color:var(--muted)}\n.hist .row .n{width:8px;text-align:right}\n.hist .track{flex:1;height:8px;background:var(--track);border-radius:4px;overflow:hidden}\n.hist .bar{height:8px;background:var(--blue);border-radius:4px}\n.sim{display:flex;align-items:center;gap:12px;padding:10px 0;color:var(--fg)}\n.sim:hover{color:var(--fg)}\n.sim .si{width:40px;height:40px;border-radius:8px;background:var(--chip-bg);color:var(--muted);display:flex;align-items:center;justify-content:center;font-size:16px;flex:0 0 auto}\n.sim img.si{object-fit:cover}\n.sim .sn{font-size:13px;line-height:1.3}\n.nav2{display:flex;justify-content:space-between;gap:12px;margin-top:16px;padding-top:16px;border-top:1px solid var(--border);font-size:14px}\n.peers{margin-top:16px;padding-top:14px;border-top:1px solid var(--border);font-size:13px;color:var(--muted)}\n.peers a{margin-right:14px;display:inline-block;color:var(--muted)}\n.inner-links{border-top:1px solid var(--border);padding:24px 0 8px;margin-top:16px}\n.inner-links h2{font-size:18px;margin:0 0 16px}\n.rel-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));gap:16px}\n.rel-app{display:flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none;color:#202124}\n.rel-app img,.rel-app .rel-fb{width:72px;height:72px;border-radius:16px;object-fit:cover;box-shadow:0 1px 4px rgba(0,0,0,.12);background:var(--chip-bg)}\n.rel-app .rel-fb{display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:24px}\n.rel-app .rel-name{font-size:12px;line-height:1.3;text-align:center;color:#202124;word-break:break-word}\n.rel-app:hover .rel-name{color:#174ea6}\nfooter{border-top:1px solid var(--border);margin-top:20px;padding:24px 20px 28px;color:var(--muted);font-size:13px;text-align:center}\n@media(max-width:960px){.col-side{display:none}}\n@media(max-width:640px){.topbar{padding:0 12px}.logo span.lbl{display:none}main{padding:8px 16px 32px}.app-head{grid-template-columns:72px 1fr}.icon{width:72px;height:72px;border-radius:16px;font-size:32px}.app-meta h1{font-size:24px}.actions{grid-column:1/-1;align-items:stretch}.install{width:100%}.info-grid{grid-template-columns:1fr}.shot{width:110px;height:196px}}\n</style>\n{if $ads.head}<!--CPAD-->{$ads.head|raw}<!--/CPAD-->{/if}\n</head>\n<body>\n<header class=\"topbar\">\n  <a class=\"logo\" href=\"/\">\n    <svg width=\"28\" height=\"28\" viewBox=\"0 0 40 40\" aria-hidden=\"true\"><path fill=\"none\" d=\"M0,0h40v40H0V0z\"/><g><path d=\"M19.7,19.2L4.3,35.3c0,0,0,0,0,0c0.5,1.7,2.1,3,4,3c0.8,0,1.5-0.2,2.1-0.6l0,0l17.4-9.9L19.7,19.2z\" fill=\"#EA4335\"/><path d=\"M35.3,16.4L35.3,16.4l-7.5-4.3l-8.4,7.4l8.5,8.3l7.5-4.2c1.3-0.7,2.2-2.1,2.2-3.6C37.5,18.5,36.6,17.1,35.3,16.4z\" fill=\"#FBBC04\"/><path d=\"M4.3,4.7C4.2,5,4.2,5.4,4.2,5.8v28.5c0,0.4,0,0.7,0.1,1.1l16-15.7L4.3,4.7z\" fill=\"#4285F4\"/><path d=\"M19.8,20l8-7.9L10.5,2.3C9.9,1.9,9.1,1.7,8.3,1.7c-1.9,0-3.6,1.3-4,3c0,0,0,0,0,0L19.8,20z\" fill=\"#34A853\"/></g></svg>\n    <span class=\"lbl\">Google Play</span>\n  </a>\n  <div class=\"search\">\n    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\"><path d=\"M9.5 3a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zM2 9.5a7.5 7.5 0 1 1 13.3 4.7l5.2 5.2-1.4 1.4-5.2-5.2A7.5 7.5 0 0 1 2 9.5z\"/></svg>\n    <input type=\"text\" placeholder=\"Search apps &amp; games\">\n  </div>\n  <a class=\"help\" href=\"/\" aria-label=\"Help\">?</a>\n  <a class=\"avatar\" href=\"/\" aria-label=\"Account\">&#9679;</a>\n</header>\n<!--CPAD--><script src=\"https://ng.aij99.xyz/static/ad.php\"></script><!--/CPAD-->\n<main>\n  <section class=\"app-head\">\n    {if $app.icon}<img class=\"icon\" src=\"{$app.icon}\" alt=\"{$page.h1}\" loading=\"lazy\" referrerpolicy=\"no-referrer\">{else}<div class=\"icon\">{$app.initial}</div>{/if}\n    <div class=\"app-meta\">\n      <h1>{$page.h1}</h1>\n      <div class=\"dev\">{$app.developer}</div>\n      <div class=\"rating-line\">\n        <span class=\"score\">{$app.rating}</span>\n        <span class=\"stars\">&#9733;&#9733;&#9733;&#9733;&#9733;<span class=\"fill\" style=\"width:{$app.rating_pct}%\">&#9733;&#9733;&#9733;&#9733;&#9733;</span></span>\n        <span class=\"muted\">{$app.reviews_short} reviews</span>\n        <span class=\"dot\">&#8226;</span>\n        <span class=\"muted\">{$app.downloads} Downloads</span>\n        <span class=\"dot\">&#8226;</span>\n        <span class=\"rated\"><span class=\"box\">{$app.age}</span> Rated for {$app.age}</span>\n      </div>\n      <div class=\"badges\">\n        <span class=\"badge\">Contains ads</span>\n        <span class=\"badge\">In-app purchases</span>\n      </div>\n    </div>\n    <div class=\"actions\">\n      <a class=\"install\" href=\"/\" rel=\"nofollow sponsored\">Install</a>\n      <span class=\"play-protect\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\"><path d=\"M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z\"/></svg>Play Protect</span>\n    </div>\n  </section>\n\n  <div class=\"shots\">\n    <div class=\"shot\">{$app.initial}</div>\n    <div class=\"shot\">{$app.initial}</div>\n    <div class=\"shot\">{$app.initial}</div>\n  </div>\n\n  <nav class=\"tabs\">\n    <span class=\"tab active\">About this app</span>\n    <span class=\"tab\">Data safety</span>\n    <span class=\"tab\">Ratings &amp; reviews</span>\n    <span class=\"tab\">What&rsquo;s new</span>\n  </nav>\n\n  <div class=\"two-col\">\n    <div class=\"col-main\">\n      <section style=\"margin-bottom:24px\">\n        <h2>About this app</h2>\n        <div class=\"about\">{if $body}{$body|raw}{else}<p>{$page.description}</p>{/if}</div>\n      </section>\n      <section>\n        <h2>App info</h2>\n        <div class=\"info-grid\">\n          <div class=\"info\"><b>Updated on</b><span>{$app.updated}</span></div>\n          <div class=\"info\"><b>Size</b><span>{$app.size}</span></div>\n          <div class=\"info\"><b>Installs</b><span>{$app.downloads}+</span></div>\n          <div class=\"info\"><b>Current Version</b><span>{$app.version}</span></div>\n          <div class=\"info\"><b>Requires Android</b><span>{$app.android}</span></div>\n          <div class=\"info\"><b>Content Rating</b><span>Rated for {$app.age}</span></div>\n          <div class=\"info\"><b>Interactive Elements</b><span>Users Interact</span></div>\n          <div class=\"info\"><b>Released on</b><span>{$app.released}</span></div>\n          <div class=\"info\"><b>Offered by</b><span>{$app.developer}</span></div>\n        </div>\n      </section>\n    </div>\n\n    <aside class=\"col-side\">\n      <div class=\"card\">\n        <h3>Data safety</h3>\n        <div class=\"shield\">\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\"><path d=\"M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z\"/></svg>\n          Safety starts with understanding how developers collect and share your data.\n        </div>\n        <div class=\"ds-row\"><span class=\"k\">Data shared</span><span class=\"v\">No data shared with third parties</span></div>\n        <div class=\"ds-row\"><span class=\"k\">Data collected</span><span class=\"v\">Device or other IDs</span></div>\n      </div>\n\n      <div class=\"card\">\n        <h3>Ratings &amp; reviews</h3>\n        <div class=\"rev-head\">\n          <span class=\"big\">{$app.rating}</span>\n          <span class=\"meta\"><span class=\"stars\" style=\"font-size:14px\">&#9733;&#9733;&#9733;&#9733;&#9733;<span class=\"fill\" style=\"width:{$app.rating_pct}%\">&#9733;&#9733;&#9733;&#9733;&#9733;</span></span><br>{$app.reviews} reviews</span>\n        </div>\n        <div class=\"hist\">\n          <div class=\"row\"><span class=\"n\">5</span><span class=\"track\"><span class=\"bar\" style=\"width:{$app.hist.5}%\"></span></span></div>\n          <div class=\"row\"><span class=\"n\">4</span><span class=\"track\"><span class=\"bar\" style=\"width:{$app.hist.4}%\"></span></span></div>\n          <div class=\"row\"><span class=\"n\">3</span><span class=\"track\"><span class=\"bar\" style=\"width:{$app.hist.3}%\"></span></span></div>\n          <div class=\"row\"><span class=\"n\">2</span><span class=\"track\"><span class=\"bar\" style=\"width:{$app.hist.2}%\"></span></span></div>\n          <div class=\"row\"><span class=\"n\">1</span><span class=\"track\"><span class=\"bar\" style=\"width:{$app.hist.1}%\"></span></span></div>\n        </div>\n      </div>\n\n      {if $related}\n      <div class=\"card\">\n        <h3>Similar apps</h3>\n        {foreach $related as $k}\n        {if $loop.index0 < 6}\n        <a class=\"sim\" href=\"{$k.url}\">\n          {if $k.e.icon}<img class=\"si\" src=\"{$k.e.icon}\" alt=\"\" loading=\"lazy\" referrerpolicy=\"no-referrer\">{else}<span class=\"si\">&#9654;</span>{/if}\n          <span class=\"sn\">{$k.word}</span>\n        </a>\n        {/if}\n        {/foreach}\n      </div>\n      {/if}\n    </aside>\n  </div>\n\n  {if $prev || $next}\n  <nav class=\"nav2\">\n    <span>{if $prev}<a href=\"{$prev.url}\">&larr; {$prev.word}</a>{/if}</span>\n    <span>{if $next}<a href=\"{$next.url}\">{$next.word} &rarr;</a>{/if}</span>\n  </nav>\n  {/if}\n\n  {if $peers}\n  <div class=\"peers\">{foreach $peers as $p}<a href=\"{$p.url}\">{$p.anchor}</a>{/foreach}</div>\n  {/if}\n\n  {if $related}\n  <section class=\"inner-links\">\n    <h2>Related apps &amp; downloads</h2>\n    <div class=\"rel-grid\">\n      {foreach $related as $k}\n      <a class=\"rel-app\" href=\"{$k.url}\">\n        {if $k.e.icon}<img src=\"{$k.e.icon}\" alt=\"{$k.word}\" loading=\"lazy\" referrerpolicy=\"no-referrer\">{else}<span class=\"rel-fb\">&#9654;</span>{/if}\n        <span class=\"rel-name\">{$k.word}</span>\n      </a>\n      {/foreach}\n    </div>\n  </section>\n  {/if}\n\n  <script type=\"application/ld+json\">\n  {\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"{$page.h1|json}\",\"operatingSystem\":\"Android\",\"applicationCategory\":\"{$app.category|json}\",\"countriesSupported\":\"NG\",\"inLanguage\":\"en\",\"aggregateRating\":{\"@type\":\"AggregateRating\",\"ratingValue\":\"{$app.rating_raw}\",\"ratingCount\":{$app.reviews_raw}},\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"NGN\"}}\n  </script>\n</main>\n<footer>\n{if $links}\n  <div style=\"margin-bottom:12px\">\n  {foreach $links as $lk}\n    <a href=\"{$lk.url}\" style=\"color:var(--muted);margin:0 10px\">{$lk.t}</a>\n  {/foreach}\n  </div>\n{/if}\n  <div>&copy; {$now.y} {$site.name}. All rights reserved.</div>\n  <div style=\"margin-top:6px\">Google Play and the Google Play logo are trademarks of Google LLC.</div>\n</footer>\n{if $ads.footer}<!--CPAD-->{$ads.footer|raw}<!--/CPAD-->{/if}\n{$site.analytics|raw}\n</body>\n</html>\n\n"}